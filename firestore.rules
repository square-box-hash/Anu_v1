rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net: default deny everything
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isVerifiedOwner(userId) {
      return isVerified() && request.auth.uid == userId;
    }

    function isValidUserProfile(data, userId) {
      return data.keys().hasAll(['uid', 'displayName', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'displayName', 'photoUrl', 'createdAt', 'updatedAt'])
        && data.uid is string
        && isValidId(data.uid)
        && data.uid == userId
        && data.displayName is string
        && data.displayName.size() <= 120
        && (!('photoUrl' in data) || (data.photoUrl is string && data.photoUrl.size() <= 500))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidUserPrivateInfo(data, userId) {
      return data.keys().hasAll(['uid', 'email', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'email', 'updatedAt'])
        && data.uid is string
        && isValidId(data.uid)
        && data.uid == userId
        && data.email is string
        && data.email.size() <= 320
        && data.updatedAt is timestamp;
    }

    function isValidChatSession(data, userId, chatId) {
      return data.keys().hasAll(['id', 'userId', 'title', 'messages', 'clientCreatedAt', 'clientUpdatedAt', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'userId', 'title', 'messages', 'clientCreatedAt', 'clientUpdatedAt', 'createdAt', 'updatedAt'])
        && data.id is string
        && isValidId(data.id)
        && data.id == chatId
        && data.userId is string
        && isValidId(data.userId)
        && data.userId == userId
        && data.title is string
        && data.title.size() >= 1
        && data.title.size() <= 200
        && data.messages is list
        && data.messages.size() <= 500
        && (data.messages.size() == 0 || data.messages[0] is map)
        && data.clientCreatedAt is number
        && data.clientCreatedAt > 0
        && data.clientUpdatedAt is number
        && data.clientUpdatedAt > 0
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // The workspace: skills, MCP servers, harness and settings. One document,
    // mirrored so a connector added on one device shows up on the others.
    function isValidWorkspace(data, userId) {
      return data.keys().hasAll(['uid', 'payload', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'payload', 'updatedAt'])
        && data.uid is string
        && isValidId(data.uid)
        && data.uid == userId
        && data.payload is map
        && data.updatedAt is timestamp;
    }

    match /users/{userId} {
      allow get: if isValidId(userId) && isOwner(userId);
      allow list: if false;
      allow create: if isValidId(userId)
        && isVerifiedOwner(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(userId)
        && isVerifiedOwner(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoUrl', 'updatedAt']);
      allow delete: if isValidId(userId) && isVerifiedOwner(userId);

      match /private/{docId} {
        allow get: if isValidId(userId) && docId == 'info' && isOwner(userId);
        allow list: if false;
        allow create: if isValidId(userId)
          && docId == 'info'
          && isVerifiedOwner(userId)
          && isValidUserPrivateInfo(incoming(), userId)
          && incoming().updatedAt == request.time;
        allow update: if isValidId(userId)
          && docId == 'info'
          && isVerifiedOwner(userId)
          && isValidUserPrivateInfo(incoming(), userId)
          && incoming().uid == existing().uid
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['email', 'updatedAt']);
        allow delete: if isValidId(userId) && docId == 'info' && isVerifiedOwner(userId);
      }

      match /workspace/{docId} {
        allow get, list: if isValidId(userId) && docId == 'config' && isOwner(userId);
        allow create, update: if isValidId(userId)
          && docId == 'config'
          && isVerifiedOwner(userId)
          && isValidWorkspace(incoming(), userId)
          && incoming().updatedAt == request.time;
        allow delete: if isValidId(userId) && docId == 'config' && isVerifiedOwner(userId);
      }

      match /chats/{chatId} {
        allow get: if isValidId(userId) && isValidId(chatId) && isOwner(userId);
        allow list: if isValidId(userId) && isOwner(userId) && resource.data.userId == request.auth.uid;
        allow create: if isValidId(userId)
          && isValidId(chatId)
          && isVerifiedOwner(userId)
          && isValidChatSession(incoming(), userId, chatId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && exists(/databases/$(database)/documents/users/$(userId));
        allow update: if isValidId(userId)
          && isValidId(chatId)
          && isVerifiedOwner(userId)
          && isValidChatSession(incoming(), userId, chatId)
          && incoming().id == existing().id
          && incoming().userId == existing().userId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['title', 'messages', 'clientUpdatedAt', 'updatedAt'])
          && exists(/databases/$(database)/documents/users/$(userId));
        allow delete: if isValidId(userId) && isValidId(chatId) && isVerifiedOwner(userId);
      }
    }
  }
}
